; Rewrite Rules of the Parametric Bit-Vector Rewriter RW_B
;
; Source: Appendix A of "Bit-Precise Reasoning with Parametric Bit-Vectors"
;         Berger, Zohar, Niemetz, Preiner, Reynolds, Barrett, Tinelli (SAT 2025)
;
; ---------------------------------------------------------------------------
; Concat / Extract normalisation  (Appendix A)
; ---------------------------------------------------------------------------

; bv-concat-extract-merge:
;   (pconcat (pextract s k j1) (pextract s j i)) => (pextract s k i)
;   Fires when the two extractions are from the same source s and j1 = j+1,
;   i.e. they are adjacent.
;   NOTE: the source-equality check (node[0][0] == node[1][0]) is emitted as
;   a structural guard by walk_lhs because the same Var 's' appears twice.
(define-cond-rule pbv-concat-extract-merge
  ((s ?) (i Int) (j Int) (j1 Int) (k Int))
  (= j1 (+ j 1))
  (pconcat (pextract s k j1) (pextract s j i))
  (pextract s k i))

; bv-extract-extract:
;   (pextract (pextract x j i) l k) => (pextract x (i+l) (i+k))
;   All variables are structurally bound from the LHS; the RHS builds
;   (i+l) and (i+k) as inline ADD nodes, handled by node_to_cpp in
;   generate_rewriter.py.
(define-rule pbv-extract-extract
  ((x ?) (i Int) (j Int) (k Int) (l Int))
  (pextract (pextract x j i) l k)
  (pextract x (+ i l) (+ i k)))

; bv-extract-whole:
;   (pextract x n 0) => x  when n = pbvsize(x) - 1
;   The condition uses pbvsize; arith_to_cpp in generate_rewriter.py emits
;   nm->mkNode(Kind::PBV_SIZE,...) so the Node equality check is generated
;   correctly.
(define-cond-rule pbv-extract-whole
  ((x ?) (n Int))
  (= n (- (pbvsize x) 1))
  (pextract x n 0)
  x)

; ---------------------------------------------------------------------------
; Arithmetic identities
; ---------------------------------------------------------------------------

; bv-add-zero: (pbvadd x (int_to_pbv k 0)) => x
(define-rule pbv-add-zero
  ((x ?) (k Int))
  (pbvadd x (int_to_pbv k 0))
  x)

; bv-sub-zero: (pbvsub x (int_to_pbv k 0)) => x
(define-rule pbv-sub-zero
  ((x ?) (k Int))
  (pbvsub x (int_to_pbv k 0))
  x)

; bv-add-self: (pbvadd x (pbvneg x)) => (int_to_pbv k 0)
;   NOTE: RHS needs width k which is not bound by the LHS pattern.
;   Implemented as raw C++ in theory_pbv_rewriter.cpp.
; (define-rule pbv-add-self ...)

; bv-not-neq: (= x (pbvnot x)) => false
;   (No width-dependent constant on RHS; directly expressible.)
(define-rule pbv-not-neq
  ((x ?))
  (= x (pbvnot x))
  false)

; bv-neg-sub: (pbvneg (pbvsub x y)) => (pbvsub y x)
(define-rule pbv-neg-sub
  ((x ?) (y ?))
  (pbvneg (pbvsub x y))
  (pbvsub y x))

; bv-neg-idemp: (pbvneg (pbvneg x)) => x
(define-rule pbv-neg-idemp
  ((x ?))
  (pbvneg (pbvneg x))
  x)

; bv-mul-one: (pbvmul x (int_to_pbv k 1)) => x
(define-rule pbv-mul-one
  ((x ?) (k Int))
  (pbvmul x (int_to_pbv k 1))
  x)

; bv-mul-zero: (pbvmul x (int_to_pbv k 0)) => (int_to_pbv k 0)
(define-rule pbv-mul-zero
  ((x ?) (k Int))
  (pbvmul x (int_to_pbv k 0))
  (int_to_pbv k 0))

; bv-mul-two: (pbvmul x (int_to_pbv k 2)) => (pbvadd x x)
(define-rule pbv-mul-two
  ((x ?) (k Int))
  (pbvmul x (int_to_pbv k 2))
  (pbvadd x x))

; ---------------------------------------------------------------------------
; Extend elimination
; ---------------------------------------------------------------------------

; bv-zero-extend-eliminate: (pzero_extend 0 x) => x
(define-rule pbv-zero-extend-eliminate
  ((x ?))
  (pzero_extend 0 x)
  x)

; bv-sign-extend-eliminate: (psign_extend 0 x) => x
(define-rule pbv-sign-extend-eliminate
  ((x ?))
  (psign_extend 0 x)
  x)

; ---------------------------------------------------------------------------
; Comparison reduction
; ---------------------------------------------------------------------------

; bv-ugt-eliminate: (pbvugt x y) => (pbvult y x)
(define-rule pbv-ugt-eliminate
  ((x ?) (y ?))
  (pbvugt x y)
  (pbvult y x))

; bv-uge-eliminate: (pbvuge x y) => (pbvule y x)
(define-rule pbv-uge-eliminate
  ((x ?) (y ?))
  (pbvuge x y)
  (pbvule y x))

; bv-sgt-eliminate: (pbvsgt x y) => (pbvslt y x)
(define-rule pbv-sgt-eliminate
  ((x ?) (y ?))
  (pbvsgt x y)
  (pbvslt y x))

; bv-sge-eliminate: (pbvsge x y) => (pbvsle y x)
(define-rule pbv-sge-eliminate
  ((x ?) (y ?))
  (pbvsge x y)
  (pbvsle y x))

; ---------------------------------------------------------------------------
; Shift by constant zero / shift of zero value
; ---------------------------------------------------------------------------

; bv-shl-by-const-0: (pbvshl x (int_to_pbv k 0)) => x
(define-rule pbv-shl-by-const-0
  ((x ?) (k Int))
  (pbvshl x (int_to_pbv k 0))
  x)

; bv-shl-by-const-2: (pbvshl x (int_to_pbv k k)) => (int_to_pbv k 0)
;   Fires when the shift amount equals the bit-width k (i.e., shifts out all bits).
;   k is bound twice in the LHS: as the width argument of int_to_pbv and as its
;   value argument.  The duplicate-Var guard ensures k_width == k_value.
(define-rule pbv-shl-by-const-2
  ((x ?) (k Int))
  (pbvshl x (int_to_pbv k k))
  (int_to_pbv k 0))

; bv-lshr-by-const-0: (pbvlshr x (int_to_pbv k 0)) => x
(define-rule pbv-lshr-by-const-0
  ((x ?) (k Int))
  (pbvlshr x (int_to_pbv k 0))
  x)

; bv-lshr-by-const-2: (pbvlshr x (int_to_pbv k k)) => (int_to_pbv k 0)
;   Analogous to bv-shl-by-const-2: all bits are shifted out.
(define-rule pbv-lshr-by-const-2
  ((x ?) (k Int))
  (pbvlshr x (int_to_pbv k k))
  (int_to_pbv k 0))

; bv-ashr-by-const-0: (pbvashr x (int_to_pbv k 0)) => x
(define-rule pbv-ashr-by-const-0
  ((x ?) (k Int))
  (pbvashr x (int_to_pbv k 0))
  x)

; bv-shl-zero: (pbvshl (int_to_pbv k 0) x) => (int_to_pbv k 0)
(define-rule pbv-shl-zero
  ((x ?) (k Int))
  (pbvshl (int_to_pbv k 0) x)
  (int_to_pbv k 0))

; bv-lshr-zero: (pbvlshr (int_to_pbv k 0) x) => (int_to_pbv k 0)
(define-rule pbv-lshr-zero
  ((x ?) (k Int))
  (pbvlshr (int_to_pbv k 0) x)
  (int_to_pbv k 0))

; bv-ashr-zero: (pbvashr (int_to_pbv k 0) x) => (int_to_pbv k 0)
(define-rule pbv-ashr-zero
  ((x ?) (k Int))
  (pbvashr (int_to_pbv k 0) x)
  (int_to_pbv k 0))

; ---------------------------------------------------------------------------
; Bitwise identity / annihilation
; ---------------------------------------------------------------------------

; bv-and-zero: (pbvand x (int_to_pbv k 0)) => (int_to_pbv k 0)
(define-rule pbv-and-zero
  ((x ?) (k Int))
  (pbvand x (int_to_pbv k 0))
  (int_to_pbv k 0))

; bv-or-zero: (pbvor x (int_to_pbv k 0)) => x
(define-rule pbv-or-zero
  ((x ?) (k Int))
  (pbvor x (int_to_pbv k 0))
  x)

; bv-or-one: (pbvor x (pbvnot (int_to_pbv k 0))) => (pbvnot (int_to_pbv k 0))
(define-rule pbv-or-one
  ((x ?) (k Int))
  (pbvor x (pbvnot (int_to_pbv k 0)))
  (pbvnot (int_to_pbv k 0)))

; bv-bitwise-idemp-2: (pbvor x x) => x
;   OR of a term with itself is idempotent.  The duplicate Var x triggers the
;   structural self-equality guard in the generated C++ matcher.
(define-rule pbv-bitwise-idemp-2
  ((x ?))
  (pbvor x x)
  x)

; bv-bitwise-not-or: (pbvor x (pbvnot x)) => (pbvnot (int_to_pbv k 0))
;   NOTE: RHS requires the all-ones constant whose width k equals |x|.
;   k is not structurally bound by the LHS pattern, so this rule CANNOT be
;   expressed as a flat RARE rule.
;   Implemented as raw C++ in theory_pbv_rewriter.cpp.
; (define-rule pbv-bitwise-not-or
; ((x ?))
; (pbvor x (pbvnot x))
; (pbvnot (int_to_pbv (pbvsize x) 0)))

; bv-xor-zero: (pbvxor x (int_to_pbv k 0)) => x
(define-rule pbv-xor-zero
  ((x ?) (k Int))
  (pbvxor x (int_to_pbv k 0))
  x)

; bv-xor-duplicate: (pbvxor x x) => (int_to_pbv k 0)
(define-rule pbv-xor-duplicate 
  ((x ?))
  (pbvxor x x)
  (int_to_pbv (pbvsize x) 0))

; bv-xor-simplify-2: (pbvxor x (pbvnot x)) => (pbvnot (int_to_pbv k 0))
;   NOTE: Same width-on-RHS constraint; implemented as raw C++ in theory_pbv_rewriter.cpp.
; (define-rule pbv-xor-simplify-2 ...)

; bv-xor-not: (pbvxor (pbvnot x) y) => (pbvnot (pbvxor x y))
(define-rule pbv-xor-not
  ((x ?) (y ?))
  (pbvxor (pbvnot x) y)
  (pbvnot (pbvxor x y)))

; bv-not-idemp: (pbvnot (pbvnot x)) => x
(define-rule pbv-not-idemp
  ((x ?))
  (pbvnot (pbvnot x))
  x)

; ---------------------------------------------------------------------------
; Unsigned less-than constant-zero / self corners
;   (put zero-constant rules BEFORE unconditional self-equality rules so the
;    if-chain short-circuits correctly)
; ---------------------------------------------------------------------------

; bv-ult-zero-1: (pbvult (int_to_pbv k 0) x) => (not (= x (int_to_pbv k 0)))
(define-rule pbv-ult-zero-1
  ((x ?) (k Int))
  (pbvult (int_to_pbv k 0) x)
  (not (= x (int_to_pbv k 0))))

; bv-ult-zero-2: (pbvult x (int_to_pbv k 0)) => false
(define-rule pbv-ult-zero-2
  ((x ?) (k Int))
  (pbvult x (int_to_pbv k 0))
  false)

; bv-ult-one: (pbvult x (int_to_pbv k 1)) => (= x (int_to_pbv k 0))
(define-rule pbv-ult-one
  ((x ?) (k Int))
  (pbvult x (int_to_pbv k 1))
  (= x (int_to_pbv k 0)))

; bv-ult-self: (pbvult x x) => false
(define-rule pbv-lt-self
  ((x ?))
  (pbvult x x)
  false)

; bv-lt-self: (pbvslt x x) => false
(define-rule pbv-slt-self
  ((x ?))
  (pbvslt x x)
  false)

; bv-ule-zero: (pbvule x (int_to_pbv k 0)) => (= x (int_to_pbv k 0))
(define-rule pbv-ule-zero
  ((x ?) (k Int))
  (pbvule x (int_to_pbv k 0))
  (= x (int_to_pbv k 0)))

; bv-zero-ule: (pbvule (int_to_pbv k 0) x) => true
(define-rule pbv-zero-ule
  ((x ?) (k Int))
  (pbvule (int_to_pbv k 0) x)
  true)

; bv-ule-self: (pbvule x x) => true
(define-rule pbv-ule-self
  ((x ?))
  (pbvule x x)
  true)

; bv-sle-self: (pbvsle x x) => true
(define-rule pbv-sle-self
  ((x ?))
  (pbvsle x x)
  true)

; bv-ule-max: (pbvule x (pbvnot 0)) => true
(define-rule pbv-ule-max
  ((x ?) (k Int))
  (pbvule x (pbvnot (int_to_pbv k 0)))
  true)

; ---------------------------------------------------------------------------
; Division / modulo identities
; ---------------------------------------------------------------------------

; bv-udiv-zero: (pbvudiv x (int_to_pbv k 0)) => (pbvnot (int_to_pbv k 0))
(define-rule pbv-udiv-zero
  ((x ?) (k Int))
  (pbvudiv x (int_to_pbv k 0))
  (pbvnot (int_to_pbv k 0)))

; bv-udiv-one: (pbvudiv x (int_to_pbv k 1)) => x
(define-rule pbv-udiv-one
  ((x ?) (k Int))
  (pbvudiv x (int_to_pbv k 1))
  x)

; bv-urem-one: (pbvurem x (int_to_pbv k 1)) => (int_to_pbv k 0)
(define-rule pbv-urem-one
  ((x ?) (k Int))
  (pbvurem x (int_to_pbv k 1))
  (int_to_pbv k 0))

; bv-urem-self: (pbvurem x x) => (int_to_pbv k 0)
(define-rule pbv-urem-self
  ((x ?))
  (pbvurem x x)
  (int_to_pbv (pbvsize x) 0))

; ---------------------------------------------------------------------------
; Right-to-left extract-and merge (Section 4.1, Example 5 reversed)
;   Applied in the right-to-left direction for T_PBV to avoid extra mod/pow2.
; ---------------------------------------------------------------------------

; bv-reverse-extract-and:
;   (pbvand (pextract x j i) (pextract y j i)) => (pextract (pbvand x y) j i)
(define-rule pbv-reverse-extract-and
  ((x ?) (y ?) (i Int) (j Int))
  (pbvand (pextract x j i) (pextract y j i))
  (pextract (pbvand x y) j i))

; ---------------------------------------------------------------------------
; NOTE: the extract-over-extend rules (A1/A2/B1/B2) are NOT here. Their side
; condition w(x) = i+1 cannot be decided syntactically, so they live in the
; pbv-mw preprocessing pass (--pbv-preprocess-mw). See preprocessing/passes/pbv_mw.h.
;
; Retired header   (--pbv-rw-mw, off by default)
;
; The low w bits of an extension are exactly its source, so a low extract can
; be pushed through the bitwise/arithmetic operators and annihilated at any
; extension whose source has width w.  This matters because psign_extend's
; integer encoding is an msb ITE plus two extra pow2 terms and a product; once
; the int-blaster has built that, the structure cannot be recovered.  Applying
; these rules BEFORE translation deletes the extension outright.
;
; pbvand is deliberately absent: pbv-reverse-extract-and rewrites in the
; opposite direction and the pair would not terminate.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; Shift-of-shift merge   (--pbv-rw-mw, off by default)
;
; Two nested shifts by symbolic amounts translate to a NESTED exponential:
; pbvlshr becomes `x div 2^y`, so (x >> y) >> z becomes 2^(...2^...), which
; the arithmetic solver cannot reason about. Merging them leaves a single
; exponential.
;
; SOUNDNESS: the naive (x >> y) >> z = x >> (y+z) is WRONG in BV semantics,
; because y+z is computed modulo 2^k and can wrap. At k=8, y=z=128 gives
; y+z = 0, so x >> 0 = x, while (x>>128)>>128 = 0.
;
; The guard `pbvuge (pbvadd y z) y` is exactly "y+z did not overflow"
; (unsigned addition wraps iff the sum drops below an operand). When it
; holds, y+z is the true sum and `x >> (y+z)` already yields 0 for sums >= k.
; When it fails, y+z >= 2^k, so at least one of y,z is >= 2^(k-1) >= k
; (for k >= 1) and the true result is 0. Hence the ite is exact.
;
; pbvashr is deliberately absent: it fills with the sign bit rather than 0,
; so the overflow branch is not the zero constant and the merge saturates at
; k-1 instead of wrapping. That needs a different rule.
; ---------------------------------------------------------------------------

(define-rule pbv-merge-lshr
  ((x ?) (y ?) (z ?))
  (pbvlshr (pbvlshr x y) z)
  (ite (pbvuge (pbvadd y z) y)
       (pbvlshr x (pbvadd y z))
       (int_to_pbv (pbvsize x) 0)))

(define-rule pbv-merge-shl
  ((x ?) (y ?) (z ?))
  (pbvshl (pbvshl x y) z)
  (ite (pbvuge (pbvadd y z) y)
       (pbvshl x (pbvadd y z))
       (int_to_pbv (pbvsize x) 0)))

; ---------------------------------------------------------------------------
; Nested extension merge   (--pbv-rw-mw, off by default)
;
; Two stacked extensions collapse into one, saving a translation step. Neither
; pattern occurs in cav26 today, but the pbv-mw extract push-down can expose
; them: pushing an extract through an operator can leave an extension sitting
; directly on another one.
;
; zext(n, zext(m, x)) = zext(n+m, x)   -- both pad with zeros, so stacking is
;                                         the same as one wider pad.
;
; sext(n, sext(m, x)) = sext(n+m, x)   -- the inner sext replicates x's sign
;                                         bit, and the outer replicates that
;                                         same bit, so all n+m added bits equal
;                                         the original sign bit.
;
; The MIXED forms are deliberately absent:
;   zext(n, sext(m, x)) is NOT sext(n+m, x) -- the outer pad is zeros while
;   sext would replicate the sign bit; they differ whenever x is negative.
;   sext(n, zext(m, x)) is NOT zext(n+m, x) unless m > 0 forces the sign bit
;   of the inner result to 0, which is a side condition on m, not a rewrite.
; ---------------------------------------------------------------------------

(define-rule pbv-merge-zext
  ((x ?) (n Int) (m Int))
  (pzero_extend n (pzero_extend m x))
  (pzero_extend (+ n m) x))

(define-rule pbv-merge-sext
  ((x ?) (n Int) (m Int))
  (psign_extend n (psign_extend m x))
  (psign_extend (+ n m) x))

; ---------------------------------------------------------------------------
; Bitwise identities from the parabit rule set   (--pbv-rw-mw=cav26)
;
; Source: rewrite_rules.rs of the CAV 2026 parabit artifact; the numbering in
; the comments is the index in that file's rule list.
;
; These fill in the pbvand side of RW_B, which had only the zero case
; (pbv-and-zero) and the extract merge (pbv-reverse-extract-and), while pbvor
; and pbvxor already carried their idempotence and negation rules.  In parabit
; the AND and OR cases are symmetric; here they were not.
;
; All are unconditional and none introduces a new bitwise operator, so design
; principle (i) of Section 4.1 holds.
;
; ONE rule is deliberately ABSENT:
;
;   parabit 70  (xor x 1) -> (pconcat (pextract x (k-1) 1) (pbvnot (pextract x 0 0)))
;
; The concat form is malformed at k = 1: `(pextract x 0 1)` has its high index
; below its low index, and there is no k >= 2 side condition available to a
; syntactic rewriter.  (At k = 1 the correct result is simply (pbvnot x).)
; parabit does not hit this because its preconditions are discharged against
; an e-graph that already knows the concrete widths.  If wanted, this belongs
; in the pbv-mw preprocessing pass, where width side conditions can be
; discharged against the asserted `(= (pbvsize x) V)` links.
;
; Note on pbv-c26-and-one below: its RHS width is (k-1) + 1 = k, which matches
; the LHS only when k is the width of x.  In T_PBV that is an admissibility
; condition rather than a typing one -- the single PBitVec sort does not force
; the operands of pbvand to share a width -- but the same is already true of
; accepted RW_B rules such as pbv-shl-by-const-2 and pbv-ult-one, which build
; their RHS at the width of the int_to_pbv operand.  It needs k >= 1, which
; Adm(phi) supplies for every width.
; ---------------------------------------------------------------------------

; parabit 50 -- and_allones: (and (bw p a) (bw p -1)) => (bw p a)
(define-rule pbv-c26-and-allones
  ((x ?) (k Int))
  (pbvand x (pbvnot (int_to_pbv k 0)))
  x)

; parabit 54 -- and_self: (and a a) => a
;   The pbvor counterpart is pbv-bitwise-idemp-2; this one was missing.
(define-rule pbv-c26-and-self
  ((x ?))
  (pbvand x x)
  x)

; parabit 56 -- and_not_self: (and (bw p a) (bw p (not (bw p a)))) => 0
;   The pbvor counterpart is pbv-bitwise-not-or (raw C++); this one was missing.
(define-rule pbv-c26-and-not-self
  ((x ?))
  (pbvand x (pbvnot x))
  (int_to_pbv (pbvsize x) 0))

; parabit 51 -- and_one: (and (bw p a) 1) => (bw 1 a)
;   Keep only bit 0 and zero-fill the rest.  See the width note in the section
;   header above.
(define-rule pbv-c26-and-one
  ((x ?) (k Int))
  (pbvand x (int_to_pbv k 1))
  (pzero_extend (- k 1) (pextract x 0 0)))

; parabit 53 -- xor_allones: (bw p (xor (bw p a) (bw p -1))) => (bw p (not (bw p a)))
(define-rule pbv-c26-xor-allones
  ((x ?) (k Int))
  (pbvxor x (pbvnot (int_to_pbv k 0)))
  (pbvnot x))

; parabit 79 -- neg_not: (- (bw p a)) <=> (+ (not (bw p a)) 1)
;   Oriented RIGHT-TO-LEFT only.  parabit has it bidirectional because egg
;   saturates an e-graph; applied left-to-right in a destructive rewriter it
;   would replace a single pbvneg with two nodes, and the integer translation
;   of pbvnot + pbvadd is strictly larger than that of pbvneg.
(define-rule pbv-c26-not-plus-one
  ((x ?) (k Int))
  (pbvadd (pbvnot x) (int_to_pbv k 1))
  (pbvneg x))
